# RHWP 설정 예시 — 이 파일을 .env 로 복사해서 고친다:   cp .env.example .env
# (값을 비우거나 줄을 지우면 오른쪽 기본값이 쓰인다)

# ── 포트 ───────────────────────────────────────────────
# 접속 주소: http://<호스트>:17780/rhwp/
RHWP_PORT=17780

# ── 저장 위치 ───────────────────────────────────────────
# 사용자 DB(users.db·secret.key)와 서버 저장 문서 폴더.
# 기본은 이 폴더 안의 db/, files/ (없으면 자동 생성).
# ⚠ Portainer 스택이면 반드시 절대 경로로: 예) /volume1/docker/rhwp/db
# ⚠ db 는 로컬 디스크에 둘 것 (NFS·SMB 로 마운트한 폴더는 SQLite 가 잠금을 못 해 깨질 수 있다)
RHWP_DB_DIR=./db
# 문서 폴더는 NAS 공유폴더를 직접 가리켜도 된다: 예) /volume1/문서/rhwp
#   files/<사용자>/   : 각 사용자의 '내 문서' (사용자를 만들면 자동 생성)
#   files/mount/<이름>/ : NAS 의 다른 폴더를 붙이는 자리 (모든 사용자 공유)
#                        → docker-compose.override.yml.example 참고
RHWP_FILES_DIR=./files

# ── 파일 소유자 ─────────────────────────────────────────
# db/·files/ 와 저장되는 문서의 소유자. NAS 에서 File Station·SMB 로 파일을 열고 고칠 사용자.
# 확인: SSH 접속 후  id <NAS사용자>   →  uid=1026(kim) gid=100(users)  이면 1026 / 100
# (0=root 는 쓸 수 없다)
PUID=1026
PGID=100

# ── 첫 관리자 (사용자가 한 명도 없을 때 첫 실행에서만 쓰인다) ─────
RHWP_AUTH_ADMIN_USER=admin
# 비워 두면 임의 비밀번호를 만들어 로그에 한 번 출력한다:
#   docker logs rhwp-auth 2>&1 | grep '첫 관리자'
RHWP_AUTH_ADMIN_PASSWORD=

# ── 로그인 ─────────────────────────────────────────────
RHWP_AUTH_TITLE=RHWP
# 로그인 유지 시간(시간). 168 = 7일
RHWP_AUTH_SESSION_HOURS=168
# auto  : 접속 방식(HTTP/HTTPS)에 맞춰 자동 (기본)
# true  : HTTPS 로만 접속할 때 (NPG 로 외부 HTTPS 를 쓰면 권장. 대신 http://IP:포트 로는 로그인 유지 안 됨)
# false : HTTP 로만 쓸 때
RHWP_AUTH_COOKIE_SECURE=auto

# ── 서버 저장 ───────────────────────────────────────────
# 문서 하나의 최대 크기(MB). NPG 등 앞단 프록시의 업로드 제한도 이보다 커야 한다.
RHWP_FILES_MAX_MB=100

# ── 이미지 버전 (보통 그대로) ──────────────────────────────
# latest 는 RHWP 새 정식 릴리스를 따라간다. 특정 버전에 고정하려면 태그를 적는다.
# 태그 목록: https://hub.docker.com/r/zardkim/rhwpweb/tags , https://hub.docker.com/r/zardkim/rhwpweb-auth/tags
RHWP_TAG=latest
RHWP_AUTH_TAG=latest
