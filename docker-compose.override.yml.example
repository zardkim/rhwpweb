# NAS 의 다른 폴더를 RHWP 에 '공유 폴더'로 붙이는 예시.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   (아래 경로를 고친 뒤)  docker compose up -d
#
# docker compose 는 docker-compose.override.yml 을 자동으로 함께 읽는다. 그래서 GitHub 에서 받은
# 새 docker-compose.yml 로 바꿔도 이 파일의 설정은 그대로 남는다. (05:00 자동 업데이트에도 적용)
# ⚠ Portainer 스택은 이 파일을 읽지 않는다 → 스택 편집기에서 rhwp-auth 의 volumes 에 직접 추가.
#
# 규칙
#  - 컨테이너 쪽 경로는 반드시 /files/mount/<보여줄 이름>  (이 이름이 '서버에서 열기' 에 공유 폴더로 보인다)
#  - 로그인한 **모든 사용자**가 보고 열 수 있다. 저장도 된다 (삭제는 관리자만).
#  - 읽기만 허용하려면 끝에 :ro 를 붙인다.
#  - 그 폴더에 PUID:PGID(.env) 사용자가 읽기(저장하려면 쓰기) 권한이 있어야 한다.
#    rhwp-auth 는 공유 폴더 안 파일의 소유자·권한을 바꾸지 않는다.
#  - 호스트의 files/mount/ 아래에 같은 이름의 빈 폴더가 생긴다 (마운트 자리). 지우지 않아도 된다.
services:
  rhwp-auth:
    volumes:
      - /volume1/문서/공용:/files/mount/공용
      - /volume1/문서/양식:/files/mount/양식:ro
